# Copia este archivo como .env y pon tu key de Google AI Studio (nunca la subas al repo)
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
# live = Gemma real · demo = respuestas simuladas solo para probar la interfaz
GEMMA_MODE=live
# minimal (por defecto, más rápido) · default = deja pensar al modelo
GEMMA_THINKING=minimal
